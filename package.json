{
  "name": "pocketbase-notes-app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "lint": "biome check --verbose .",
    "lint:fix": "biome check --verbose --write .",
    "knip": "knip",
    "preview": "vite preview",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "pb:codegen": "bun run scripts/codegen.ts",
    "test:install": "playwright install chromium webkit",
    "test:smoke": "bun run scripts/test-services.ts && playwright test --grep @smoke",
    "test:api": "bun run scripts/test-services.ts && bun run scripts/test-attachments.ts && bun run scripts/test-capabilities.ts && bun run scripts/test-mfa.ts && bun run scripts/test-backups.ts && bun run scripts/test-notes.ts",
    "test:accounts": "bun run scripts/test-seed.ts && bun run scripts/test-deployment-accounts.ts && bun run scripts/test-restore.ts",
    "test:e2e": "bun run test:api && playwright test",
    "test:report": "playwright show-report",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ],
  "dependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/lucide": "^1.2.152",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-router": "^1.170.46",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "pocketbase": "^0.28.2",
    "prosekit": "^0.23.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "knip": "^6.44.2",
    "pocketbase-typegen": "^1.6.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitepress": "2.0.0-alpha.21"
  }
}
