{
  "name": "pocketbase-notes-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "lint": "biome check --verbose .",
    "lint:fix": "biome check --verbose --write .",
    "preview": "vite preview",
    "pb:codegen": "bun run scripts/codegen.ts",
    "test:install": "playwright install chromium",
    "test:smoke": "bun run scripts/test-services.ts && playwright test --grep @smoke",
    "test:api": "bun run scripts/test-services.ts && bun run scripts/test-entries.ts && bun run scripts/test-attachments.ts",
    "test:e2e": "bun run test:api && playwright test",
    "test:report": "playwright show-report"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ],
  "dependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/lucide": "^1.2.142",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@tabler/icons-react": "^3.6.0",
    "@tanstack/react-router": "^1.170.31",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "pocketbase": "^0.28.0",
    "prosekit": "^0.22.2",
    "radix-ui": "^1.8.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "pocketbase-typegen": "^1.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
