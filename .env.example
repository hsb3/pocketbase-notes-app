# Required by Docker Compose. Generate with: openssl rand -base64 24
# https://pocketbase.io/docs/going-to-production/#enable-settings-encryption
PB_ENCRYPTION_KEY=

# Host port for the PocketBase container (docker-compose.yml). Default: 8080
PB_PORT=8080

# [DEV] for frontend development only; must match PB_PORT
VITE_PB_URL=http://localhost:8080

# [DEV] superuser credentials: used by pb:codegen (pocketbase-typegen) and scripts/seed.sh
# https://github.com/patmood/pocketbase-typegen
PB_EMAIL=email@example.com
PB_PASSWORD=strong-password

# [DEV] optional overrides for the regular user created by scripts/seed.sh
# SEED_USER_EMAIL=user@example.com
# SEED_USER_PASSWORD=user-changeme-123

# [DEV] run the frontend without a backend, auth bypassed (dev builds only).
# Normally set by `make dev-solo`, not here.
# VITE_AUTH_BYPASS=true
