# Local development configuration. Copy to .env; never commit credentials.
# VITE_* values are public browser build-time configuration, NEVER secrets.
# Restart Vite after changes; production frontend changes require a rebuild.

# Required by Docker Compose. Generate once: openssl rand -base64 24
# Keep stable for existing encrypted PocketBase settings.
PB_ENCRYPTION_KEY=

# PocketBase host port. Keep VITE_PB_URL in sync.
PB_PORT=8080
# Absolute backend URL for local frontend, codegen, seed-data and integration tests.
# Omit in production frontend builds for same-origin API requests (default: /).
VITE_PB_URL=http://localhost:8080

# Local superuser credentials for seeding, codegen, service setup and tests.
PB_EMAIL=email@example.com
PB_PASSWORD=strong-password

# Optional regular seed-user credentials (defaults shown).
# SEED_USER_EMAIL=user@example.com
# SEED_USER_PASSWORD=user-changeme-123
# Optional scripts/seed.sh-only backend override. Normally use make seed,
# which supplies PB_PORT (default 8080). Direct script fallback is localhost:8090.
# PB_URL=http://localhost:8080

# Full development stack: make up-full or make start-full enables/configures
# Mailpit SMTP and RustFS S3 in persisted PocketBase settings, not feature flags.
# Keep using the full stack afterward; make up does not disable those settings.
# Local RustFS credentials and bucket (defaults shown). No browser access keys.
# Changing the bucket does not migrate existing files; setup refuses an active
# bucket change or enabling S3 over existing local files.
# Former MINIO_* variables are no longer read. Existing MinIO data requires
# an S3 copy and verification before switching; see deploy/README.md.
# RUSTFS_ACCESS_KEY=pocketbase
# RUSTFS_SECRET_KEY=pocketbase
# RUSTFS_BUCKET=pocketbase
# Frontend address in verification/reset emails; applied by make up-full.
# DEV_APP_URL=http://127.0.0.1:5173

# The only app feature flag: exact "true" skips the frontend route auth guard
# in Vite development builds only. Normally supplied by make dev-solo.
# It does NOT authenticate a user or bypass PocketBase access rules.
# VITE_AUTH_BYPASS=false

# Sharing, collaboration, AI and offline sync are not implemented: no env toggle.
# Entries/files are private by collection rules. SMTP/S3 enablement is managed
# in PocketBase settings; production providers must be configured separately.
# Editor features and attachment limits are code/schema settings, not env vars.
# See docs/ATTACHMENTS.md for supported files, limits and cleanup behavior.

# Optional test overrides (defaults shown). Tests need a disposable local backend
# and superuser credentials; browser tests also require a running frontend.
# TEST_PB_URL affects scripts/test-entries.ts only; others use VITE_PB_URL.
# TEST_PB_URL=http://localhost:8080
# TEST_APP_URL=http://127.0.0.1:5173
# Any nonempty DEBUG_BROWSER logs browser console errors; leave unset to disable.
# DEBUG_BROWSER=1
# Node module search path if Playwright is installed outside this project.
# NODE_PATH=
