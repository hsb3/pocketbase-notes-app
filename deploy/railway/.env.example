# Deployment infrastructure and superuser credentials only. Copy to .env locally;
# keep the real file private (0600) and out of version control.
PB_URL=https://notes-staging.up.railway.app
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Preserve the existing encryption key across deployments and restores.
PB_ENCRYPTION_KEY=
PB_SMTP_PASSWORD=
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_URL_STYLE=virtual-host

# Optional verification inputs belong to the invoking shell:
# DEPLOY_EVIDENCE_DIR: absolute private output directory.
# VERIFY_EMAIL: unused test mailbox, only for the explicit mail drill.
# RESEND_API_KEY: management key injected only for that mail drill.
# RESTORE_URL: isolated loopback restore with outgoing mail/backup cron disabled.
# Personal app-user passwords are not deployment inputs.
