# Deployment infrastructure and superuser credentials only. Copy to
# deploy/railway/.env, keep it private (chmod 600) and out of version control.
# Personal app-user passwords are not deployment inputs.

# Public HTTPS address of your deployment, e.g. https://notes.example.com
PB_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Same value as the service variable. Preserve it across deployments and restores.
PB_ENCRYPTION_KEY=

# Outgoing mail (make railway-configure). Host, port and username default to
# Resend: smtp.resend.com, 465, resend. The sender must be on a domain your
# provider has verified.
PB_SENDER_ADDRESS=
PB_SMTP_PASSWORD=
# PB_SMTP_HOST=smtp.resend.com
# PB_SMTP_PORT=465
# PB_SMTP_USERNAME=resend

# Request header(s) that carry the visitor's address, comma-separated. Rate limits
# count per address; Railway's edge sets X-Real-IP. Leave unset for that default;
# set it empty to trust no header (then every visitor shares the edge's address).
# PB_TRUSTED_PROXY_HEADERS=X-Real-IP

# Private S3-compatible bucket for scheduled PocketBase backups.
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_URL_STYLE=virtual-host
# Daily at 07:00 UTC unless changed; seven archives are kept.
# BACKUP_CRON=0 7 * * *

# Per-run inputs belong on the command line, not in this file:
# CONFIRM / DEPLOY_CONFIRM: hostname of PB_URL; required to act on a remote target.
# DEPLOY_EVIDENCE_DIR: absolute private output directory.
# DEPLOY_ALLOW_LOCAL: exact true to opt into a loopback test target.
# VERIFY_EMAIL: unused test mailbox, only for the mail drill.
# RESEND_API_KEY: key that can read sent mail, only for the mail drill.
# RESTORE_URL: isolated loopback restore with outgoing mail and backup cron disabled.
