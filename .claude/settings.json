{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "atelier@dotfiles-agents": true,
    "solo-skills@dotfiles-agents": true,
    "diagrams@dotfiles-agents": true,
    "plugin-feedback@dotfiles-agents": true,
    "obsidian-toolkit@dotfiles-agents": false,
    "ponytail@ponytail": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dotfiles-agents": {
      "source": {
        "source": "github",
        "repo": "hsb3/dotfiles-agents"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "kata attention-hook end --source kata-agent-hook-end",
            "type": "command"
          }
        ],
        "matcher": "logout|prompt_input_exit|bypass_permissions_disabled|other"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "kata attention-hook start --source kata-agent-hook-start",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
