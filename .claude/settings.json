{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "bun@dotfiles-agents": true,
    "pocketbase@dotfiles-agents": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dotfiles-agents": {
      "source": {
        "source": "github",
        "repo": "hsb3/dotfiles-agents"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.specify/events.py\" speckit.functionform-gate.stop stop 60",
            "timeout": 65,
            "__speckit_event__": true
          }
        ]
      }
    ]
  }
}
